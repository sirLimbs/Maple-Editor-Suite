<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MapleImgEditor</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ApplicationIcon>..\MapleEditor.UI\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MapleLib\MapleLib.csproj" />
    <ProjectReference Include="..\MapleEditor.UI\MapleEditor.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="MapleImgEditor\Assets\iconRewardTemplate.png">
      <LogicalName>MapleImgEditor.Assets.iconRewardTemplate.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SharpDX"><HintPath>..\lib\SharpDX.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.Direct2D1"><HintPath>..\lib\SharpDX.Direct2D1.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>..\lib\SharpDX.Direct3D11.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.Direct3D9"><HintPath>..\lib\SharpDX.Direct3D9.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>..\lib\SharpDX.DXGI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.Mathematics"><HintPath>..\lib\SharpDX.Mathematics.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.MediaFoundation"><HintPath>..\lib\SharpDX.MediaFoundation.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.XAudio2"><HintPath>..\lib\SharpDX.XAudio2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpDX.XInput"><HintPath>..\lib\SharpDX.XInput.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup></Project>

